# Certify Desktop RC: generated safe template. Never store real credentials here.
APP_NAME=Certrxy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=single
LOG_LEVEL=warning

# Identity/version read from original desktop template. Preserve app ID across upgrades.
NATIVEPHP_APP_ID=com.certify.offline
NATIVEPHP_APP_VERSION=2.0.3-alpha.1
NATIVEPHP_APP_DESCRIPTION="Offline certificate generator for Windows"
NATIVEPHP_APP_AUTHOR="Certify"
NATIVEPHP_NSIS_DELETE_APP_DATA=false
NATIVEPHP_UPDATER_ENABLED=false

# Offline PDF engine is selected by Certify at runtime.
CERTIFY_QPDF_BINARY=
CERTIFY_GHOSTSCRIPT_BINARY=
NATIVEPHP_APP_NAME=Certrxy
NATIVEPHP_APP_FILENAME=certrxy
